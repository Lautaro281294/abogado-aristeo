<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content="Blog y novedades del Estudio Jurídico Aristeo. Actualidad en derecho laboral, civil, consumo y salud en Córdoba."/>
  <meta name="robots" content="index, follow"/>
  <meta name="author" content="Dr. Lautaro Nahuel Aristeo"/>
  
  <title>Blog Jurídico | Estudio Jurídico Aristeo</title>

  <script defer src="https://cdn.vercel-insights.com/v1/script.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

  <style>
  /* ════ SISTEMA DE DISEÑO Y VARIABLES GLOBALES (OLIVA) ════ */
  :root {
    --bg-base:     #161913; 
    --bg-surface:  #1f241a; 
    --bg-panel:    #292f22; 
    --line-color:  rgba(194, 163, 109, 0.15); 
    --line-hover:  rgba(194, 163, 109, 0.35);
    
    --gold-main:   #c2a36d; 
    --gold-light:  #e3c999; 
    --gold-dark:   #8a7346; 
    
    --text-main:   #F7F5F0; 
    --text-muted:  rgba(247, 245, 240, 0.75); 
    
    --font-heading: 'Cormorant Garamond', Georgia, serif;
    --font-body:    'DM Sans', system-ui, sans-serif;
    
    --ease:         cubic-bezier(0.16, 1, 0.3, 1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; font-size: 16px; }
  
  html, body { 
    background-color: var(--bg-base); color: var(--text-main); 
    font-family: var(--font-body); font-weight: 300; line-height: 1.85; 
    -webkit-font-smoothing: antialiased; 
    overflow-x: hidden; 
    width: 100%; 
    max-width: 100vw; 
  }
  
  ::selection { background-color: var(--gold-dark); color: var(--text-main); }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg-base); }
  ::-webkit-scrollbar-thumb { background: var(--gold-dark); border-radius: 3px; }

  .container { max-width: 1400px; margin: 0 auto; padding: 0 5vw; }
  .section { padding: 10rem 0; border-top: 1px solid var(--line-color); position: relative; }

  .label { 
    display: inline-flex; align-items: center; gap: 1rem; 
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.35em; 
    text-transform: uppercase; color: var(--gold-main); margin-bottom: 2rem; 
  }
  .label::before { content: ''; width: 40px; height: 1px; background: var(--gold-main); flex-shrink: 0; }

  .heading-2 { 
    font-family: var(--font-heading); font-size: clamp(2.8rem, 5vw, 4.5rem); 
    font-weight: 400; line-height: 1.1; color: var(--text-main); 
    letter-spacing: -0.01em; margin-bottom: 2.5rem; 
  }
  .heading-2 em { font-style: italic; color: var(--gold-light); }

  .reveal { opacity: 0; transform: translateY(40px); transition: 1s var(--ease); }
  .reveal.in { opacity: 1; transform: translateY(0); }

  /* ════ HEADER Y RESPONSIVE ════ */
  .header { 
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000; 
    padding: 2.2rem 0; transition: padding 0.5s var(--ease), background 0.5s var(--ease); 
    background: transparent;
  }
  .header.scrolled { 
    background: rgba(22, 25, 19, 0.98); backdrop-filter: blur(15px); 
    padding: 1.2rem 0; border-bottom: 1px solid var(--line-color); 
  }
  
  .nav-wrap { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 1rem; }
  
  .brand { text-decoration: none; flex-shrink: 0; display: flex; flex-direction: column; z-index: 1100; position: relative; }
  .brand-top { font-size: 0.75rem; letter-spacing: 0.4em; text-transform: uppercase; color: var(--gold-main); font-weight: 600; margin-bottom: 2px; white-space: nowrap; }
  .brand-name { font-family: var(--font-heading); font-size: 2.2rem; font-weight: 500; letter-spacing: 0.15em; color: var(--text-main); text-transform: uppercase; transition: color 0.3s; white-space: nowrap; }
  .brand:hover .brand-name { color: var(--gold-light); }

  .mobile-toggle { display: none; background: none; border: none; color: var(--gold-main); font-size: 1.8rem; cursor: pointer; transition: 0.3s; z-index: 1100; position: relative; }
  .mobile-toggle:hover { color: var(--gold-light); }

  .nav-links { display: flex; gap: 3rem; align-items: center; flex: 1; justify-content: flex-end; }
  .nav-a { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-main); text-decoration: none; transition: color 0.3s; position: relative; padding: 5px 0; white-space: nowrap; }
  .nav-a::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 1px; background: var(--gold-main); transition: width 0.3s var(--ease); }
  .nav-a:hover { color: var(--gold-light); }
  .nav-a:hover::after { width: 100%; }
  
  /* Estado activo para el Blog */
  .nav-a.active { color: var(--gold-main); }
  .nav-a.active::after { width: 100%; }

  .drop { position: relative; display: flex; align-items: center; padding: 10px 0; }
  .drop-menu { 
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(15px); 
    background: var(--bg-surface); border: 1px solid var(--line-color); padding: 1.2rem 0; 
    min-width: 280px; opacity: 0; visibility: hidden; transition: 0.4s var(--ease); box-shadow: 0 30px 60px rgba(0,0,0,0.8); 
    display: flex; flex-direction: column;
  }
  .drop:hover .drop-menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .drop-item { display: flex; align-items: center; gap: 1rem; padding: 0.8rem 2.5rem; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.15em; text-decoration: none; transition: 0.3s; border-left: 2px solid transparent; width: 100%; }
  .drop-item i { font-size: 0.8rem; color: var(--gold-dark); transition: 0.3s; }
  .drop-item:hover { background: var(--bg-panel); color: var(--gold-light); border-left-color: var(--gold-main); padding-left: 3rem; }
  .drop-item:hover i { color: var(--gold-main); }

  .btn-header { 
    display: inline-flex; align-items: center; gap: 12px; font-size: 0.75rem; font-weight: 600; 
    letter-spacing: 0.15em; text-transform: uppercase; color: var(--bg-base); background: var(--gold-main); 
    padding: 1rem 2.2rem; text-decoration: none; transition: 0.4s; border: 1px solid var(--gold-main); flex-shrink: 0; white-space: nowrap; 
  }
  .btn-header:hover { background: transparent; color: var(--gold-main); }

  /* ════ ESTILOS EXCLUSIVOS DE LA GRILLA DEL BLOG ════ */
  .blog-hero { padding-top: 180px; padding-bottom: 5rem; background: var(--bg-base); }
  
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; margin-top: 4rem; }
  
  .post-card { 
    background: var(--bg-panel); border: 1px solid var(--line-color); 
    transition: 0.4s var(--ease); text-decoration: none; display: flex; flex-direction: column; overflow: hidden;
  }
  .post-card:hover { border-color: var(--gold-main); transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
  
  .thumb-wrap { width: 100%; height: 240px; overflow: hidden; border-bottom: 1px solid var(--line-color); }
  .post-thumb { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .post-card:hover .post-thumb { transform: scale(1.05); }
  
  .post-content { padding: 2.5rem; display: flex; flex-direction: column; flex-grow: 1; }
  .post-date { font-size: 0.7rem; color: var(--gold-main); letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 600; }
  .post-title { font-family: var(--font-heading); font-size: 1.8rem; color: var(--text-main); margin-bottom: 1rem; line-height: 1.3; font-weight: 400; }
  .post-excerpt { font-size: 1rem; color: var(--text-muted); margin-bottom: 2rem; line-height: 1.7; }
  
  .post-link { 
    margin-top: auto; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; 
    letter-spacing: 0.2em; color: var(--gold-main); display: inline-flex; align-items: center; gap: 10px; 
    border-bottom: 1px solid transparent; padding-bottom: 3px; transition: 0.3s; align-self: flex-start;
  }
  .post-card:hover .post-link { border-color: var(--gold-main); gap: 15px; }

  /* ════ FOOTER ════ */
  .footer { padding: 6rem 0 3rem; border-top: 1px solid var(--line-color); background: var(--bg-surface); margin-top: 5rem; }
  .foot-center { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.5rem; margin-bottom: 3rem; }
  .foot-logo { font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-main); }
  .foot-info { font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-muted); line-height: 2; }
  .foot-bottom { padding-top: 2rem; border-top: 1px solid rgba(194, 163, 109, 0.1); text-align: center; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-muted); line-height: 1.8; }

  /* ════ MEDIA QUERIES ════ */
  @media (max-width: 1200px) { .nav-links { gap: 1.5rem; } .brand-name { font-size: 1.8rem; } }
  @media (max-width: 900px) {
    .header { padding: 1rem 0; background: rgba(22, 25, 19, 0.98); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line-color); }
    .brand { max-width: 70vw; overflow: hidden; z-index: 1100; }
    .brand-name { font-size: 1.5rem; letter-spacing: 0.1em; }
    .brand-top { font-size: 0.65rem; letter-spacing: 0.2em; }
    .mobile-toggle { display: block; }
    .nav-links { 
      position: absolute; top: 100%; left: 0; right: 0; 
      background: rgba(22, 25, 19, 0.98); backdrop-filter: blur(15px); 
      flex-direction: column; padding: 2rem; gap: 1.5rem; 
      opacity: 0; visibility: hidden; transform: translateY(-10px); 
      transition: 0.4s var(--ease); border-bottom: 1px solid var(--line-color); 
      box-shadow: 0 10px 30px rgba(0,0,0,0.8); z-index: 1050;
    }
    .nav-links.active { opacity: 1; visibility: visible; transform: translateY(0); }
    .nav-a, .btn-header { width: 100%; text-align: center; justify-content: center; }
    .drop { flex-direction: column; width: 100%; }
    .drop-menu { 
      position: static; transform: none; opacity: 1; visibility: visible; 
      display: none; background: transparent; border: none; box-shadow: none; 
      padding: 1rem 0 0 0; min-width: 100%; text-align: center; width: 100%;
    }
    .drop.active .drop-menu { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
    .drop-item { justify-content: center; text-align: center; padding: 0.8rem 0; border: none; width: 100%; font-size: 0.75rem; }
    .drop-item:hover { padding-left: 0; color: var(--gold-main); background: transparent; }
    .blog-hero { padding-top: 140px; }
  }
  @media (max-width: 480px) { .container { padding: 0 6vw; } .btn-header { padding: 1rem 1.5rem; font-size: 0.7rem; } }
  </style>
</head>
<body>

